alias: Circulate when stuffy (Reactive)
description: Turns on fan when CO2 is high, turns off when low
triggers:
  - trigger: numeric_state
    entity_id:
      - sensor.aranet4_2ac3a_carbon_dioxide
    above: 925
    id: stuffy
  - trigger: numeric_state
    entity_id: sensor.aranet4_2ac3a_carbon_dioxide
    below: 800
    id: fresh
  - trigger: time_pattern
    hours: '*'
    id: Hourly
conditions:
  - condition: numeric_state
    entity_id: sensor.current_energy_price
    below: 0.13
actions:
  - choose:
      - conditions:
          - condition: and
            conditions:
              - condition: trigger
                id: stuffy
              - condition: time
                after: '21:00:00'
                before: '08:00:00'
        sequence:
          - action: climate.set_fan_mode
            target:
              entity_id: climate.thermostat
            data:
              fan_mode: diffuse
      - conditions:
          - condition: trigger
            id: fresh
        sequence:
          - action: climate.set_fan_mode
            target:
              entity_id: climate.thermostat
            data:
              fan_mode: auto
      - conditions:
          - condition: trigger
            id:
              - Hourly
        sequence:
          - if:
              - condition: and
                conditions:
                  - condition: numeric_state
                    entity_id: sensor.aranet4_2ac3a_carbon_dioxide
                    above: 925
                  - condition: time
                    after: '21:00:00'
                    before: '08:00:00'
            then:
              - action: climate.set_fan_mode
                target:
                  entity_id: climate.thermostat
                data:
                  fan_mode: diffuse
mode: restart
